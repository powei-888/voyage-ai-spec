# API
PORT=3001
ALLOW_INSECURE_DEMO_AUTH=false
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://voyage:voyage@localhost:5432/voyage_ai?schema=public
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_USER_EMAIL=demo@voyage.local
DEMO_USER_NAME="示範旅人"
DEMO_USER_PASSWORD=voyage-demo
UPLOAD_DIR=uploads
AI_PROVIDER=local
OCR_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_KEEP_ALIVE=0
LOCAL_LLM_TIMEOUT_MS=180000
LOCAL_LLM_NUM_CTX=8192
LOCAL_OCR_BASE_URL=http://127.0.0.1:11438
LOCAL_PDF_PARSER_BASE_URL=http://127.0.0.1:11436
LOCAL_OCR_TIMEOUT_MS=180000
OCR_WORKER_ENABLED=true
OCR_WORKER_POLL_MS=1000
OCR_WORKER_LEASE_MS=240000
OCR_RETRY_BASE_MS=5000
OCR_MAX_ATTEMPTS=3
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_BLOCK_MS=900000
REQUIRE_INVITE_FOR_REGISTRATION=false
INVITE_PREVIEW_RATE_LIMIT=120
INVITE_REDEEM_RATE_LIMIT=20
HEALTH_MIN_FREE_BYTES=536870912
ENABLE_HSTS=false

# Backup
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_DATABASE_USER=voyage
BACKUP_DATABASE_NAME=voyage_ai

# Web
API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Docker Compose PostgreSQL
POSTGRES_USER=voyage
POSTGRES_PASSWORD=voyage
POSTGRES_DB=voyage_ai
POSTGRES_PORT=5432
