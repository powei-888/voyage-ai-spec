generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  active
  archived
}

enum TripRole {
  owner
  member
}

enum TripMemberKind {
  traveler
  external
}

enum TripInviteMode {
  single
  group
}

enum EventCategory {
  attraction
  restaurant
  hotel
  transport
  activity
  shopping
  free_time
  other
}

enum ExpenseCategory {
  food
  hotel
  transport
  shopping
  ticket
  activity
  other
}

enum ExpenseStatus {
  active
  voided
}

enum ExpenseSplitMethod {
  equal
  custom
}

enum ExpensePaymentSource {
  member
  fund
}

enum FundTransactionType {
  contribution
  refund
  adjustment_credit
  adjustment_debit
  collection
}

enum ProxyPurchaseStatus {
  requested
  purchased
  cancelled
}

enum ReceiptStatus {
  pending
  processing
  extracted
  confirmed
  failed
}

enum BookingType {
  flight
  hotel
  train
  bus
  restaurant
  activity
  car_rental
  other
}

enum AIProposalType {
  itinerary_check
  itinerary_update
  expense_summary
  receipt_review
  booking_parse
  memory_draft
}

enum AIProposalStatus {
  pending
  accepted
  rejected
  expired
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedTrips        Trip[]                 @relation("TripOwner")
  memberships       TripMember[]
  sessions          Session[]
  inviteRedemptions TripInviteRedemption[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Trip {
  id                 String     @id @default(uuid())
  name               String
  destinationCountry String?
  destinationCity    String?
  startDate          DateTime
  endDate            DateTime
  baseCurrency       String     @default("USD")
  budgetAmount       Decimal?
  ownerUserId        String
  status             TripStatus @default(active)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  owner          User             @relation("TripOwner", fields: [ownerUserId], references: [id])
  members        TripMember[]
  days           ItineraryDay[]
  events         ItineraryEvent[]
  receipts       Receipt[]
  expenses       Expense[]
  bookings       Booking[]
  proposals      AIProposal[]
  settlements    Settlement[]
  proxyPurchases ProxyPurchase[]
  invites        TripInvite[]
  funds          TripFund[]

  @@index([ownerUserId])
  @@index([startDate])
  @@index([status])
}

model TripMember {
  id          String         @id @default(uuid())
  tripId      String
  userId      String?
  displayName String
  role        TripRole       @default(member)
  kind        TripMemberKind @default(traveler)
  joinedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  trip Trip  @relation(fields: [tripId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  createdEvents           ItineraryEvent[]       @relation("EventCreator")
  eventParticipants       EventParticipant[]
  uploadedReceipts        Receipt[]              @relation("ReceiptUploader")
  confirmedReceipts       Receipt[]              @relation("ReceiptConfirmer")
  paidExpenses            Expense[]              @relation("ExpensePayer")
  createdExpenses         Expense[]              @relation("ExpenseCreator")
  expenseShares           ExpenseParticipant[]
  createdBookings         Booking[]              @relation("BookingCreator")
  createdProposals        AIProposal[]           @relation("AIProposalCreator")
  appliedProposals        AIProposal[]           @relation("AIProposalApplier")
  settlementsSent         Settlement[]           @relation("SettlementSender")
  settlementsReceived     Settlement[]           @relation("SettlementReceiver")
  createdSettlements      Settlement[]           @relation("SettlementCreator")
  proxyPurchasesReceived  ProxyPurchase[]        @relation("ProxyPurchaseRecipient")
  proxyPurchasesPaid      ProxyPurchase[]        @relation("ProxyPurchasePayer")
  createdProxyPurchases   ProxyPurchase[]        @relation("ProxyPurchaseCreator")
  createdInvites          TripInvite[]           @relation("TripInviteCreator")
  inviteRedemptions       TripInviteRedemption[] @relation("TripInviteMember")
  fundTransactions        FundTransaction[]      @relation("FundTransactionMember")
  createdFundTransactions FundTransaction[]      @relation("FundTransactionCreator")
  voidedFundTransactions  FundTransaction[]      @relation("FundTransactionVoider")

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([tripId, kind])
  @@index([tripId, displayName])
}

model TripInvite {
  id                String         @id @default(uuid())
  tripId            String
  tokenHash         String         @unique
  mode              TripInviteMode
  maxUses           Int
  useCount          Int            @default(0)
  expiresAt         DateTime
  revokedAt         DateTime?
  createdByMemberId String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  trip            Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByMember TripMember             @relation("TripInviteCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  redemptions     TripInviteRedemption[]

  @@index([tripId, createdAt])
  @@index([expiresAt])
  @@index([createdByMemberId])
}

model TripInviteRedemption {
  id         String   @id @default(uuid())
  inviteId   String
  userId     String
  memberId   String?
  redeemedAt DateTime @default(now())

  invite TripInvite  @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  member TripMember? @relation("TripInviteMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([inviteId, userId])
  @@index([userId])
  @@index([memberId])
}

model ItineraryDay {
  id        String   @id @default(uuid())
  tripId    String
  date      DateTime
  dayIndex  Int
  title     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip             @relation(fields: [tripId], references: [id])
  events ItineraryEvent[]

  @@unique([tripId, date])
  @@unique([tripId, dayIndex])
  @@index([tripId])
}

model ItineraryEvent {
  id                    String        @id @default(uuid())
  tripId                String
  dayId                 String
  title                 String
  category              EventCategory @default(other)
  startTime             DateTime?
  endTime               DateTime?
  locationName          String?
  address               String?
  latitude              Decimal?
  longitude             Decimal?
  notes                 String?
  estimatedCostAmount   Decimal?
  estimatedCostCurrency String?
  sortOrder             Int           @default(0)
  createdByMemberId     String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  trip            Trip               @relation(fields: [tripId], references: [id])
  day             ItineraryDay       @relation(fields: [dayId], references: [id])
  createdByMember TripMember?        @relation("EventCreator", fields: [createdByMemberId], references: [id])
  participants    EventParticipant[]
  bookings        Booking[]
  expenses        Expense[]

  @@index([tripId])
  @@index([dayId])
  @@index([dayId, sortOrder])
  @@index([category])
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  memberId  String
  createdAt DateTime @default(now())

  event  ItineraryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member TripMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([memberId])
}

model Receipt {
  id                  String        @id @default(uuid())
  tripId              String
  uploadedByMemberId  String?
  imageUrl            String
  imageOriginalName   String?
  imageMimeType       String?
  ocrStatus           ReceiptStatus @default(pending)
  extractedJson       Json?
  confidenceScore     Decimal?
  ocrAttemptCount     Int           @default(0)
  ocrMaxAttempts      Int           @default(3)
  ocrNextAttemptAt    DateTime      @default(now())
  ocrStartedAt        DateTime?
  ocrCompletedAt      DateTime?
  ocrLeaseExpiresAt   DateTime?
  ocrLastError        String?
  confirmedByMemberId String?
  confirmedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  trip               Trip                @relation(fields: [tripId], references: [id])
  uploadedByMember   TripMember?         @relation("ReceiptUploader", fields: [uploadedByMemberId], references: [id])
  confirmedByMember  TripMember?         @relation("ReceiptConfirmer", fields: [confirmedByMemberId], references: [id])
  /// Canonical confirmed expense, owned by Expense.linkedReceiptId.
  confirmedExpense   Expense?            @relation("ReceiptConfirmedExpense")
  proxyPurchases     ProxyPurchase[]     @relation("ReceiptProxyPurchases")
  proxyPurchaseItems ProxyPurchaseItem[] @relation("ReceiptProxyPurchaseItems")

  @@index([tripId])
  @@index([ocrStatus])
  @@index([ocrStatus, ocrNextAttemptAt])
  @@index([ocrLeaseExpiresAt])
  @@index([uploadedByMemberId])
  @@index([confirmedByMemberId])
}

model Expense {
  id                String               @id @default(uuid())
  tripId            String
  title             String
  merchant          String?
  amount            Decimal
  currency          String
  category          ExpenseCategory      @default(other)
  expenseDate       DateTime?
  paymentSource     ExpensePaymentSource @default(member)
  payerMemberId     String?
  fundId            String?
  linkedReceiptId   String?              @unique
  linkedEventId     String?
  status            ExpenseStatus        @default(active)
  splitMethod       ExpenseSplitMethod   @default(equal)
  createdByMemberId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  trip            Trip                 @relation(fields: [tripId], references: [id])
  payerMember     TripMember?          @relation("ExpensePayer", fields: [payerMemberId], references: [id])
  fund            TripFund?            @relation(fields: [fundId], references: [id])
  createdByMember TripMember?          @relation("ExpenseCreator", fields: [createdByMemberId], references: [id])
  /// The single canonical receipt-to-expense relation; uniqueness makes confirmation idempotent.
  linkedReceipt   Receipt?             @relation("ReceiptConfirmedExpense", fields: [linkedReceiptId], references: [id])
  linkedEvent     ItineraryEvent?      @relation(fields: [linkedEventId], references: [id])
  participants    ExpenseParticipant[]
  proxyPurchases  ProxyPurchase[]

  @@index([tripId])
  @@index([payerMemberId])
  @@index([fundId])
  @@index([linkedEventId])
  @@index([status])
  @@index([createdByMemberId])
}

model TripFund {
  id        String   @id @default(uuid())
  tripId    String
  name      String
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip           Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  transactions   FundTransaction[]
  proxyPurchases ProxyPurchase[]

  @@unique([tripId, currency])
  @@index([tripId])
}

model FundTransaction {
  id                String              @id @default(uuid())
  fundId            String
  type              FundTransactionType
  memberId          String?
  amount            Decimal
  transactionDate   DateTime
  note              String?
  proxyPurchaseId   String?
  createdByMemberId String?
  voidedAt          DateTime?
  voidedByMemberId  String?
  voidReason        String?
  createdAt         DateTime            @default(now())

  fund            TripFund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member          TripMember?    @relation("FundTransactionMember", fields: [memberId], references: [id])
  proxyPurchase   ProxyPurchase? @relation(fields: [proxyPurchaseId], references: [id], onDelete: SetNull)
  createdByMember TripMember?    @relation("FundTransactionCreator", fields: [createdByMemberId], references: [id])
  voidedByMember  TripMember?    @relation("FundTransactionVoider", fields: [voidedByMemberId], references: [id], onDelete: Restrict)

  @@index([fundId, transactionDate])
  @@index([memberId])
  @@index([proxyPurchaseId])
  @@index([createdByMemberId])
  @@index([voidedByMemberId])
}

model ExpenseParticipant {
  id          String   @id @default(uuid())
  expenseId   String
  memberId    String
  shareAmount Decimal
  createdAt   DateTime @default(now())

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  TripMember @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  id                String   @id @default(uuid())
  tripId            String
  fromMemberId      String
  toMemberId        String
  amount            Decimal
  currency          String
  note              String?
  settledAt         DateTime
  createdByMemberId String?
  proxyPurchaseId   String?
  createdAt         DateTime @default(now())

  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromMember      TripMember     @relation("SettlementSender", fields: [fromMemberId], references: [id])
  toMember        TripMember     @relation("SettlementReceiver", fields: [toMemberId], references: [id])
  createdByMember TripMember?    @relation("SettlementCreator", fields: [createdByMemberId], references: [id])
  proxyPurchase   ProxyPurchase? @relation(fields: [proxyPurchaseId], references: [id], onDelete: SetNull)

  @@index([tripId, settledAt])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([proxyPurchaseId])
}

model ProxyPurchase {
  id                String               @id @default(uuid())
  tripId            String
  externalMemberId  String
  payerMemberId     String?
  paymentSource     ExpensePaymentSource @default(member)
  fundId            String?
  expenseId         String?              @unique
  status            ProxyPurchaseStatus  @default(requested)
  currency          String
  note              String?
  purchasedAt       DateTime?
  createdByMemberId String?
  sourceReceiptId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  trip             Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  externalMember   TripMember          @relation("ProxyPurchaseRecipient", fields: [externalMemberId], references: [id])
  payerMember      TripMember?         @relation("ProxyPurchasePayer", fields: [payerMemberId], references: [id])
  fund             TripFund?           @relation(fields: [fundId], references: [id])
  expense          Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdByMember  TripMember?         @relation("ProxyPurchaseCreator", fields: [createdByMemberId], references: [id])
  sourceReceipt    Receipt?            @relation("ReceiptProxyPurchases", fields: [sourceReceiptId], references: [id], onDelete: SetNull)
  items            ProxyPurchaseItem[]
  settlements      Settlement[]
  fundTransactions FundTransaction[]

  @@index([tripId, status])
  @@index([externalMemberId])
  @@index([payerMemberId])
  @@index([fundId])
  @@index([createdByMemberId])
  @@index([sourceReceiptId])
}

model ProxyPurchaseItem {
  id                     String   @id @default(uuid())
  proxyPurchaseId        String
  description            String
  quantity               Int      @default(1)
  unitPrice              Decimal
  amount                 Decimal
  note                   String?
  sortOrder              Int      @default(0)
  sourceReceiptId        String?
  sourceReceiptItemIndex Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  proxyPurchase ProxyPurchase @relation(fields: [proxyPurchaseId], references: [id], onDelete: Cascade)
  sourceReceipt Receipt?      @relation("ReceiptProxyPurchaseItems", fields: [sourceReceiptId], references: [id], onDelete: SetNull)

  @@unique([sourceReceiptId, sourceReceiptItemIndex])
  @@index([proxyPurchaseId, sortOrder])
  @@index([sourceReceiptId])
}

model Booking {
  id                String      @id @default(uuid())
  tripId            String
  type              BookingType
  title             String
  provider          String?
  confirmationCode  String?
  startTime         DateTime?
  endTime           DateTime?
  location          String?
  attachmentUrl     String?
  linkedEventId     String?
  createdByMemberId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  trip            Trip            @relation(fields: [tripId], references: [id])
  linkedEvent     ItineraryEvent? @relation(fields: [linkedEventId], references: [id])
  createdByMember TripMember?     @relation("BookingCreator", fields: [createdByMemberId], references: [id])

  @@index([tripId])
  @@index([type])
  @@index([linkedEventId])
  @@index([startTime])
  @@index([createdByMemberId])
}

model AIProposal {
  id                String           @id @default(uuid())
  tripId            String
  type              AIProposalType
  inputText         String?
  summary           String
  proposedJson      Json
  status            AIProposalStatus @default(pending)
  createdByMemberId String?
  appliedByMemberId String?
  appliedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  trip            Trip        @relation(fields: [tripId], references: [id])
  createdByMember TripMember? @relation("AIProposalCreator", fields: [createdByMemberId], references: [id])
  appliedByMember TripMember? @relation("AIProposalApplier", fields: [appliedByMemberId], references: [id])

  @@index([tripId])
  @@index([type])
  @@index([status])
  @@index([createdByMemberId])
  @@index([appliedByMemberId])
}
