[Unit]
Description=Voyage AI Web
After=network-online.target voyage-api.service
Wants=network-online.target voyage-api.service

[Service]
Type=simple
WorkingDirectory=%h/voyage-ai-spec
EnvironmentFile=%h/.config/voyage-ai/voyage.env
ExecStart=/usr/bin/npm run start --workspace @voyage/web -- -p 3100 -H 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
